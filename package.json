{
  "name": "separator-desktop",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev --config apps/desktop/src-tauri/tauri.conf.json",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "node scripts/generate_types.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:e2e": "node scripts/native_acceptance.mjs",
    "lint": "eslint apps/desktop/src tests --max-warnings 0",
    "format": "prettier --write apps/desktop/src packages/shared/*.ts",
    "package": "node scripts/package_application.mjs",
    "tauri": "tauri",
    "schema": "PYTHONPATH=engine .venv/bin/python scripts/generate_schema.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "@tauri-apps/plugin-updater": "^2.13.2",
    "ajv": "^8.20.0",
    "json-schema-to-typescript": "^16.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.8.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.3.3",
    "vitest": "^4.0.18"
  }
}

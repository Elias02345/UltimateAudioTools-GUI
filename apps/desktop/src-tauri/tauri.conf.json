{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Separator",
  "version": "0.1.0",
  "identifier": "de.eliaskanakidis.separator",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Separator",
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; media-src http://127.0.0.1:* 'self' asset: http://asset.localhost blob:; connect-src http://127.0.0.1:* ipc: http://ipc.localhost 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all",
    "category": "Music",
    "shortDescription": "High-quality local audio stem separation",
    "longDescription": "Separate vocals, instruments and more with RoFormer models and custom ensembles. Audio stays on your computer.",
    "resources": {
      "../../../engine/separator_engine/": "engine/separator_engine/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libtbb12",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-libav"
        ]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "compression": "zlib"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDhCMThGQjU2QUYzNjc3MTIKUldRU2R6YXZWdnNZaXorMGFXRCtnOElzM3ZPa0VnTUt3SXVTUkJnNWpqd1V0YjN4NGlSTHBGaTYK",
      "endpoints": [
        "https://github.com/Elias02345/UltimateAudioTools-GUI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
